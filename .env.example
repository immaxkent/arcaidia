# ---------------------------------------------------------------------------
# Arcaidia — environment template. Copy to .env and fill in. Never commit .env.
# Chain IDs, CCTP domains and contract addresses live in packages/domain/src/config,
# not here. This file holds secrets and endpoint overrides only.
# ---------------------------------------------------------------------------

# --- RPC endpoints (optional overrides; defaults are the public endpoints) ---
ETHEREUM_SEPOLIA_RPC_URL=
ARC_TESTNET_RPC_URL=

# --- Solver / Liquidity Agent ---
# Two deliberately separate identities. LOCAL_AGENT_PRIVATE_KEY is the SIGNER —
# it produces the EIP-712 FillAuthorization, and must be granted via
# setAuthorisedSigner(address,bool) on each vault it fills for (see
# contracts/script/AuthorizeSolverSigner.s.sol) before the vault accepts
# anything it signs. Local development signer only; production authority is a
# Circle Agent Wallet (WP-09).
#
# LOCAL_SUBMITTER_PRIVATE_KEY is the SUBMITTER — it broadcasts fastFill() with
# that signature. It needs no onchain grant at all: the vault checks the
# recovered signer, never msg.sender, so any funded address may relay. Kept as
# its own key so more solvers and more submitters can be added later just by
# running another worker instance with another pair of keys.
#
# Both need their own gas on both chains — neither shares a balance with the
# deployer.
LOCAL_AGENT_PRIVATE_KEY=
LOCAL_SUBMITTER_PRIVATE_KEY=

# How often the solver polls the subgraph for pending intents. Default 10000ms
# (10s) if unset. Lowered to 2000ms 2026-09-10 for demo speed — this is pure
# HTTP polling, no push/websocket mechanism exists yet (see WP-14/latency
# discussion), so this interval is directly what "how long before the solver
# notices a new intent" costs on average (interval/2).
SOLVER_POLL_INTERVAL_MS=2000

# --- Settlement Worker (WP-10) ---
# LOCAL_REPORTER_PRIVATE_KEY calls SettlementReceiver.settle() once the real
# CCTP mint has landed. Its own key, separate from PROTOCOL_OWNER (which is
# keystore-protected and cannot sign unattended in a background process) —
# same reasoning as the solver's signer/submitter split above. Must be
# granted via SettlementReceiver.setReporter(address,bool) on each chain (see
# contracts/script/AuthorizeSettlementReporter.s.sol) before settle() accepts
# anything it submits. Also needs its own gas on both chains — it calls
# receiveMessage() too, which is permissionless.
LOCAL_REPORTER_PRIVATE_KEY=

# --- Circle Agent Wallet (WP-09) ---
# CCTP settlement itself (WP-10, CIRCLE_IRIS_BASE_URL below) needs none of these:
# Iris's GET /v2/messages attestation endpoint is public, no key required. These
# four are only for Circle's Developer-Controlled Wallets REST API. When all
# four are set, packages/agent/src/entrypoint/config.ts selects
# CircleAgentWalletSigner over LocalAgentSigner (see SolverEntrypointConfig.signerAuthority);
# leave all four unset to keep signing fills with LOCAL_AGENT_PRIVATE_KEY above.
# CIRCLE_ENTITY_SECRET is not a dashboard value: generated locally (32 random
# bytes) and registered once via registerEntitySecretCiphertext — see
# packages/agent/scripts/setup-circle-agent-wallet.ts, which does both steps
# and creates the wallet set + wallet in one run
# (https://developers.circle.com/wallets/dev-controlled/register-entity-secret).
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_AGENT_WALLET_ID=
CIRCLE_AGENT_WALLET_ADDRESS=
# Sandbox for testnet, api.circle.com for mainnet. Needs no API key.
CIRCLE_IRIS_BASE_URL=https://iris-api-sandbox.circle.com

# --- The Graph (WP-08) ---
GRAPH_API_KEY=
SUBGRAPH_URL_ETHEREUM_SEPOLIA=
SUBGRAPH_URL_ARC_TESTNET=

# --- Substreams / The Graph Market (WP-ERC4626-SUBSTREAMS) ---
# For local `substreams run` verification and Registry publish. Separate
# product/account from GRAPH_API_KEY above — obtained from thegraph.market.
SUBSTREAMS_API_KEY=

# --- Privy (WP-03) ---
# The frontend reads its own VITE_PRIVY_APP_ID from apps/web/.env — Vite loads
# env files from apps/web/, not this root file. PRIVY_APP_SECRET is unused
# until a backend calls Privy's server API; nothing reads it yet.
PRIVY_APP_SECRET=

# --- Etherscan (optional — contract verification only) ---
ETHERSCAN_API_KEY=

# Deployment config (DEPLOYER_PRIVATE_KEY, PROTOCOL_OWNER, SETTLEMENT_ASSET,
# fee/limit policy, ...) lives in contracts/.env.example, not here — Foundry
# reads its own .env from contracts/, and that's the one file both chains'
# deploys actually use. See packages/domain/src/config/deployments.ts for the
# addresses that deploy produced.
