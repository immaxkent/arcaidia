# ---------------------------------------------------------------------------
# Arcaidia — environment template. Copy to .env and fill in. Never commit .env.
# Chain IDs, CCTP domains and contract addresses live in packages/domain/src/config,
# not here. This file holds secrets and endpoint overrides only.
# ---------------------------------------------------------------------------

# --- RPC endpoints (optional overrides; defaults are the public endpoints) ---
ETHEREUM_SEPOLIA_RPC_URL=
ARC_TESTNET_RPC_URL=

# --- Solver / Liquidity Agent ---
# Local development signer only. Production authority is a Circle Agent Wallet.
LOCAL_AGENT_PRIVATE_KEY=

# --- Circle Agent Wallet (WP-09 — deferred until after V1 ships, not needed now) ---
# CCTP settlement itself (WP-10, CIRCLE_IRIS_BASE_URL below) needs none of these:
# Iris's GET /v2/messages attestation endpoint is public, no key required. These
# four are only for Circle's Developer-Controlled Wallets REST API, which V1
# never calls — V1 signs fills with LOCAL_AGENT_PRIVATE_KEY above.
# CIRCLE_ENTITY_SECRET is not a dashboard value: you generate it yourself (a
# random 32-byte secret), encrypt it with Circle's published public key, then
# register the ciphertext — see https://developers.circle.com/w3s/entity-secret-management.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_AGENT_WALLET_ID=
CIRCLE_AGENT_WALLET_ADDRESS=
# Sandbox for testnet, api.circle.com for mainnet. Needs no API key.
CIRCLE_IRIS_BASE_URL=https://iris-api-sandbox.circle.com

# --- The Graph (WP-08) ---
GRAPH_API_KEY=
SUBGRAPH_URL_ETHEREUM_SEPOLIA=
SUBGRAPH_URL_ARC_TESTNET=

# --- Privy (WP-03) ---
# The frontend reads its own VITE_PRIVY_APP_ID from apps/web/.env — Vite loads
# env files from apps/web/, not this root file. PRIVY_APP_SECRET is unused
# until a backend calls Privy's server API; nothing reads it yet.
PRIVY_APP_SECRET=

# --- Etherscan (optional — contract verification only) ---
ETHERSCAN_API_KEY=

# Deployment config (DEPLOYER_PRIVATE_KEY, PROTOCOL_OWNER, SETTLEMENT_ASSET,
# fee/limit policy, ...) lives in contracts/.env.example, not here — Foundry
# reads its own .env from contracts/, and that's the one file both chains'
# deploys actually use. See packages/domain/src/config/deployments.ts for the
# addresses that deploy produced.
