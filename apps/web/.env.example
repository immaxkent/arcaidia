# ---------------------------------------------------------------------------
# Arcaidia frontend — environment template. Vite reads env files from this
# directory (apps/web/), not the monorepo root. Copy to .env, fill in, never
# commit .env. Every var is VITE_-prefixed because Vite only exposes prefixed
# vars to browser code — see src/lib/arcaidia/config.ts, which documents and
# reads exactly this list.
# ---------------------------------------------------------------------------

# --- RPC endpoints (optional — each chain falls back to a public default) ---
VITE_RPC_URL_ETHEREUM_SEPOLIA=
VITE_RPC_URL_ARC_TESTNET=

# --- USDC (public, permanent testnet addresses — see work-packages/OPEN-QUESTIONS.md Q3) ---
VITE_USDC_ETHEREUM_SEPOLIA=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
VITE_USDC_ARC_TESTNET=0x3600000000000000000000000000000000000000

# --- Protocol contracts. Router live since 2026-09-09 (WP-10, real CCTP
# --- transport), unchanged since. Vault/receiver redeployed 2026-09-10
# --- (WP-12, live percentage-based fill/exposure caps) — see
# --- packages/domain/src/config/deployments.ts for why. Identical on both
# --- chains by CREATE2 design. ---
# v2 (2026-09-12): leave unset — the app reads the committed v2 addresses from @arcaidia/domain; set only to point at a different deployment.
# VITE_INTENT_ROUTER_ETHEREUM_SEPOLIA=0x58868465d14e0694d033bD511588AE90482b21CC
# v2 (2026-09-12): leave unset — the app reads the committed v2 addresses from @arcaidia/domain; set only to point at a different deployment.
# VITE_INTENT_ROUTER_ARC_TESTNET=0x58868465d14e0694d033bD511588AE90482b21CC
# v2 (2026-09-12): leave unset — the app reads the committed v2 addresses from @arcaidia/domain; set only to point at a different deployment.
# VITE_HOUSE_VAULT_ETHEREUM_SEPOLIA=0xc74E693938DfBf7c11b787bA27cddE4c0215AAF1
# v2 (2026-09-12): leave unset — the app reads the committed v2 addresses from @arcaidia/domain; set only to point at a different deployment.
# VITE_HOUSE_VAULT_ARC_TESTNET=0xc74E693938DfBf7c11b787bA27cddE4c0215AAF1

# --- Intent Market (post-V1 — leave unset; a set value un-hides Earn's self-deploy flow) ---
# v2 (2026-09-12): leave unset — the app reads the committed v2 addresses from @arcaidia/domain; set only to point at a different deployment.
# VITE_VAULT_FACTORY_ETHEREUM_SEPOLIA=
# v2 (2026-09-12): leave unset — the app reads the committed v2 addresses from @arcaidia/domain; set only to point at a different deployment.
# VITE_VAULT_FACTORY_ARC_TESTNET=

# --- The Graph (WP-08). Bumped to v0.0.4 2026-09-10 (WP-12): manifests
# --- repointed at the redeployed vault + settlement receiver. ---
VITE_SUBGRAPH_URL_ETHEREUM_SEPOLIA=https://api.studio.thegraph.com/query/1758886/arcaidia-ethereum-sepolia/v0.0.4
VITE_SUBGRAPH_URL_ARC_TESTNET=https://api.studio.thegraph.com/query/1758886/arcaidia-arc-testnet/v0.0.4

# --- Live quote endpoint (WP-14) — the solver process's own POST /quote.
# --- Only reachable while pnpm solver:start is actually running. ---
VITE_SOLVER_QUOTE_URL=http://localhost:8787

# --- Post-V1 services (leave unset for V1) ---
VITE_SOLVER_TELEMETRY_URL=
VITE_MARKET_INTELLIGENCE_URL=

# --- Privy (WP-03) — the App ID from your Privy dashboard's URL/Basics page ---
VITE_PRIVY_APP_ID=

# --- Demo mode (off by default; no fixtures exist in the repo yet) ---
VITE_DEMO_MODE=false
