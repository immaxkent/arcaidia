# One image recipe for every Arcaidia Node service (relay, settlement worker, load generator).
# The solver has its own Dockerfile (packages/agent/Dockerfile); this one is the same idea —
# ship TypeScript source, run it with tsx, exactly the code path the tests cover — with the
# entrypoint chosen at build time:
#
#   docker build -f deploy/Dockerfile.service --build-arg SERVICE=packages/relay/src/entrypoint/main.ts .
#
# Build from the repo root: pnpm workspaces need the whole workspace tree to resolve
# `workspace:*` dependencies.
FROM node:22-slim

RUN npm install -g pnpm@10.2.0
WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY packages/agent/package.json packages/agent/package.json
COPY packages/domain/package.json packages/domain/package.json
COPY packages/telemetry/package.json packages/telemetry/package.json
COPY packages/settlement/package.json packages/settlement/package.json
COPY packages/mcp/package.json packages/mcp/package.json
COPY packages/relay/package.json packages/relay/package.json
COPY packages/loadgen/package.json packages/loadgen/package.json
COPY apps/web/package.json apps/web/package.json
COPY tests/e2e/package.json tests/e2e/package.json
RUN pnpm install --frozen-lockfile

COPY packages packages

ARG SERVICE
ENV SERVICE=${SERVICE}
RUN test -n "$SERVICE" && test -f "$SERVICE"

RUN useradd --create-home --shell /bin/false arcaidia
USER arcaidia

ENTRYPOINT ["sh", "-c", "exec pnpm exec tsx \"$SERVICE\""]
