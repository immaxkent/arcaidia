# One image for every Arcaidia Node service (relay, x402 gateway, solvers, settlement worker,
# load generator): ship the TypeScript source and run it with tsx — exactly the code path the
# tests cover — with the entrypoint chosen at *run* time by the SERVICE environment variable:
#
#   docker build -f deploy/Dockerfile.service -t arcaidia-service .
#   docker run -e SERVICE=packages/relay/src/entrypoint/main.ts arcaidia-service
#
# Only the packages the services need are installed (no web app, no e2e harness): the image is
# a third of the size and a 2 GB box unpacks it once instead of seven times.
#
# Build from the repo root: pnpm workspaces need the whole workspace tree to resolve
# `workspace:*` dependencies.
FROM node:22-slim

RUN npm install -g pnpm@10.2.0
WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY packages/agent/package.json packages/agent/package.json
COPY packages/domain/package.json packages/domain/package.json
COPY packages/telemetry/package.json packages/telemetry/package.json
COPY packages/settlement/package.json packages/settlement/package.json
COPY packages/mcp/package.json packages/mcp/package.json
COPY packages/relay/package.json packages/relay/package.json
COPY packages/x402-gateway/package.json packages/x402-gateway/package.json
COPY packages/loadgen/package.json packages/loadgen/package.json
COPY apps/web/package.json apps/web/package.json
COPY tests/e2e/package.json tests/e2e/package.json
RUN pnpm install --frozen-lockfile --filter '@arcaidia/agent...' --filter '@arcaidia/relay...' --filter '@arcaidia/settlement...' --filter '@arcaidia/loadgen...' --filter '@arcaidia/x402-gateway...'

COPY packages packages

# Default entrypoint for a bare `docker run`; compose sets SERVICE per container.
ARG SERVICE=packages/relay/src/entrypoint/main.ts
ENV SERVICE=${SERVICE}
RUN test -f "$SERVICE"

RUN useradd --create-home --shell /bin/false arcaidia
USER arcaidia

ENTRYPOINT ["sh", "-c", "exec pnpm exec tsx \"$SERVICE\""]
