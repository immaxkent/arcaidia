{
  "name": "arcaidia",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "contracts:build": "cd contracts && forge build",
    "abi:generate": "node scripts/generate-abis.mjs",
    "abi:check": "node scripts/generate-abis.mjs --check",
    "test:shared-domain": "pnpm --filter @arcaidia/domain test",
    "test:sc-eth": "cd contracts && ARCAIDIA_SOURCE=ethereum forge test -vv",
    "test:sc-arc": "cd contracts && ARCAIDIA_SOURCE=arc forge test -vv",
    "test:sc": "pnpm test:sc-eth && pnpm test:sc-arc",
    "test:global": "pnpm contracts:build && pnpm abi:check && pnpm subgraph:check && pnpm typecheck && pnpm test:shared-domain && pnpm test:agent && pnpm test:settlement && pnpm test:mcp && pnpm test:sc-eth && pnpm test:sc-arc && pnpm test:e2e",
    "test": "pnpm test:global",
    "fmt": "cd contracts && forge fmt",
    "test:agent": "pnpm --filter @arcaidia/agent test",
    "test:chains": "pnpm --filter @arcaidia/domain exec vitest run --config vitest.live.config.ts",
    "test:settlement": "pnpm --filter @arcaidia/settlement test",
    "e2e": "pnpm contracts:build && pnpm --filter @arcaidia/e2e test",
    "test:e2e": "pnpm --filter @arcaidia/e2e test",
    "subgraph:generate": "tsx scripts/generate-subgraph.ts",
    "subgraph:check": "tsx scripts/generate-subgraph.ts --check",
    "subgraph:codegen": "graph codegen subgraph/subgraph.ethereum-sepolia.yaml --output-dir subgraph/generated",
    "subgraph:build": "pnpm subgraph:generate && pnpm subgraph:codegen && graph build subgraph/subgraph.ethereum-sepolia.yaml --output-dir subgraph/build",
    "test:mcp": "pnpm --filter @arcaidia/mcp test"
  },
  "devDependencies": {
    "@graphprotocol/graph-cli": "^0.98.1",
    "@graphprotocol/graph-ts": "^0.38.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
