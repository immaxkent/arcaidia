# ---------------------------------------------------------------------------
# Arcaidia contract deployment — Ethereum Sepolia. Copy to .env when deploying
# this chain (Foundry reads .env from this directory), fill in the blanks,
# never commit .env. See contracts/.env.arc-testnet.example for the other chain.
#
# DEPLOYER_PRIVATE_KEY is deliberately absent: run with your keystore-cached
# "deployKey" wallet instead —
#   forge script script/Deploy.s.sol \
#     --rpc-url $ETHEREUM_SEPOLIA_RPC_URL \
#     --account deployKey --sender 0x538e5E9797fa86eE25e97289439b6A3AbA0165b0 \
#     --broadcast
# Deploy.s.sol falls back to vm.startBroadcast() with no key when
# DEPLOYER_PRIVATE_KEY is unset, so --account supplies the signer and no
# private key ever touches this file or an env var.
# ---------------------------------------------------------------------------

ETHEREUM_SEPOLIA_RPC_URL=

# --- Roles — the deploying wallet doubles as owner/treasury/reporter for testnet ---
PROTOCOL_OWNER=0x538e5E9797fa86eE25e97289439b6A3AbA0165b0
PROTOCOL_TREASURY=0x538e5E9797fa86eE25e97289439b6A3AbA0165b0
SETTLEMENT_REPORTER=0x538e5E9797fa86eE25e97289439b6A3AbA0165b0

# --- Settlement asset — real testnet USDC on this chain (Q3, permanent) ---
SETTLEMENT_ASSET=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# --- Canonical settlement transport — deploy MockSettlementInitiator FIRST: ---
#   forge create --rpc-url $ETHEREUM_SEPOLIA_RPC_URL \
#     --account deployKey --broadcast \
#     src/mocks/MockSettlementInitiator.sol:MockSettlementInitiator
# then paste the address it prints below. This is the mock transport (WP-06);
# real CCTP (WP-10) isn't built yet, so canonical settlement here is simulated,
# not a real Circle burn/mint. Re-deploy once WP-10 lands.
SETTLEMENT_INITIATOR=

# --- Destination = Arc testnet ---
DESTINATION_CHAIN_ID=5042002
# Precomputed CREATE2 address — identical on every chain by construction, so
# this exact value is also correct in .env.arc-testnet.example. Verified two
# ways (viem and `cast create2`) against the current compiled bytecode before
# any contract exists on either chain — see contracts/script/Deploy.s.sol's
# own "predicted receiver" console.log to reconfirm at deploy time.
DESTINATION_SETTLEMENT_RECEIVER=0xb634d0fDa74BacF730B1eF50a32b4c83f13f11fC

RESERVE_FLOOR_BPS=1000
# 5000 = 50/50 LP/treasury split on protocol fees (Q10).
PROTOCOL_FEE_SHARE_BPS=5000
# Upper safety caps, not real transfer sizes — 50,000 USDC / 200,000 USDC at
# 6 decimals. Fine to leave as-is for testnet.
MAX_INTENT_AMOUNT=50000000000
MAX_IN_FLIGHT_VALUE=200000000000
