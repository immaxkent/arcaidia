# ---------------------------------------------------------------------------
# Arcaidia contract deployment — ONE file, both chains. Copy to .env, fill in
# the two RPC URLs, never commit .env. Foundry reads .env from this directory.
#
# The same command deploys either chain — only --rpc-url changes:
#   forge script script/Deploy.s.sol \
#     --rpc-url $ETHEREUM_SEPOLIA_RPC_URL \
#     --account deployKey --sender 0x538e5E9797fa86eE25e97289439b6A3AbA0165b0 \
#     --broadcast
#   forge script script/Deploy.s.sol \
#     --rpc-url $ARC_TESTNET_RPC_URL \
#     --account deployKey --sender 0x538e5E9797fa86eE25e97289439b6A3AbA0165b0 \
#     --broadcast
#
# DEPLOYER_PRIVATE_KEY is deliberately absent: --account/--sender on the forge
# CLI supplies the keystore-cached signer, so no private key ever touches an
# env var or this file. SETTLEMENT_ASSET and DESTINATION_CHAIN_ID are gone too
# — Deploy.s.sol now looks those up itself from block.chainid (real testnet
# USDC addresses and "the other of Arcaidia's two chains" are known constants,
# not configuration). Only SETTLEMENT_INITIATOR still varies per chain, so
# it's the one pair of chain-suffixed vars below.
# ---------------------------------------------------------------------------

ETHEREUM_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/1c06365d3f634bd088204fe3005e87ad
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io

# --- Roles — the deploying wallet doubles as owner/treasury/reporter for testnet ---
PROTOCOL_OWNER=0x538e5E9797fa86eE25e97289439b6A3AbA0165b0
PROTOCOL_TREASURY=0x538e5E9797fa86eE25e97289439b6A3AbA0165b0
SETTLEMENT_REPORTER=0x538e5E9797fa86eE25e97289439b6A3AbA0165b0

# --- Canonical settlement transport — one MockSettlementInitiator per chain ---
# --- (WP-06); real CCTP is WP-10, not built yet, so canonical settlement is  ---
# --- simulated on both chains for now. Deploy each with:                    ---
#   forge create --rpc-url $ETHEREUM_SEPOLIA_RPC_URL --account deployKey --broadcast \
#     src/mocks/MockSettlementInitiator.sol:MockSettlementInitiator
#   forge create --rpc-url $ARC_TESTNET_RPC_URL --account deployKey --broadcast \
#     src/mocks/MockSettlementInitiator.sol:MockSettlementInitiator
SETTLEMENT_INITIATOR_ETHEREUM_SEPOLIA=0xa620B2763883cEF363e21A4e1A0C6edf23ce20f2
SETTLEMENT_INITIATOR_ARC_TESTNET=0xAd42d15429b5b47C21f70F3425486021712d815c

# --- Precomputed CREATE2 address — identical on every chain by construction,   ---
# --- so one value is correct for both deploys. Verified two ways (viem and    ---
# --- `cast create2`) against the current compiled bytecode before any        ---
# --- contract existed on either chain — the script also prints its own       ---
# --- "predicted receiver" line at deploy time to reconfirm.                  ---
DESTINATION_SETTLEMENT_RECEIVER=0xb634d0fDa74BacF730B1eF50a32b4c83f13f11fC

RESERVE_FLOOR_BPS=1000
# 5000 = 50/50 LP/treasury split on protocol fees (Q10).
PROTOCOL_FEE_SHARE_BPS=5000
# Upper safety caps, not real transfer sizes — 50,000 USDC / 200,000 USDC at
# 6 decimals. Same on both chains; fine to leave as-is for testnet.
MAX_INTENT_AMOUNT=50000000000
MAX_IN_FLIGHT_VALUE=200000000000

# --- Solver signer authorization (AuthorizeSolverSigner.s.sol) ---
SOLVER_SIGNER_ADDRESS=0x316FC0ce2B92e59460144B35a748EaB1c6fc2de4
